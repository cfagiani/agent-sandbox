# Agent to run: claude or opencode
AGENT="claude"

# Directory containing your GGUF model files
MODEL_DIR="/path/to/your/models"

# Path to the llama-server binary
LLAMA_SERVER="/path/to/llama-server"

# PORT for llama.cpp server
PORT=11434

# Base name for the docker images (built as <IMAGE_NAME>-claude and <IMAGE_NAME>-opencode)
IMAGE_NAME="agent-dev"

# Which agent images build-image.sh builds (space-separated; default: both).
# Set to a single agent to build only that image, e.g. BUILD_AGENTS="opencode".
BUILD_AGENTS="claude opencode"

# LLM Context Size (set based on model)
CONTEXT_SIZE=262144

# Model alias used to select LLM_OPTIONS in start-llama.sh
# Currently supported: qwen3.6 (uses draft-mtp speculation)
# Any other value falls back to generic options (no speculation)
MODEL_ALIAS="local"

# LLM_OPTIONS are selected in start-llama.sh based on MODEL_ALIAS

# Optional: path to a multimodal projector file. When set and non-empty,
# start-llama.sh passes --mmproj <MPROJ_FILE> to llama-server.
# MMPROJ_FILE=""

# Optional: set reasoning effort
REASONING_EFFORT="medium"